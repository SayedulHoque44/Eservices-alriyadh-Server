NODE_ENV=development
PORT=3001

# MongoDB connection string (use a database dedicated to this site)
mongoDbUrl=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/saudiComputerServicesDB?retryWrites=true&w=majority

# Long random string used to sign the admin session (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRCT=change-me
ADMIN_SESSION_EXPIRES_IN=7d

# Browser origins allowed to call the API directly (comma separated)
CLIENT_ORIGINS=http://localhost:3000
# Live website URL used in share links and QR codes (set to your real domain in production)
PUBLIC_APP_URL=http://localhost:3000

# Administrator - managed in the admin panel (Account settings: change email / PIN).
# Leave these empty. Only fill them for the very first setup (no admin in the
# database yet) or to recover a forgotten PIN with `npm run seed:reset`, then
# clear them again.
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_ADMIN_ON_START=true

# Largest accepted image, in MB (keep NEXT_PUBLIC_MAX_UPLOAD_MB in Client/.env equal)
MAX_UPLOAD_MB=4

# AWS S3 – every Akama image is stored here. Keep the bucket private (Block Public Access on).
# The browser uploads straight to S3 with a presigned PUT URL, so the bucket needs a
# CORS rule: AllowedMethods PUT, AllowedOrigins <your site URL>, AllowedHeaders *.
# The IAM user needs s3:PutObject, s3:GetObject, s3:DeleteObject on the bucket.
AWS_S3_BUCKET_NAME=
AWS_S3_BUCKET_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
# Default folder inside the bucket (the client normally sends folderName itself)
AWS_S3_PREFIX=eservices-alriyadh/akama
# CloudFront URL in front of the bucket. Absher images are shown as <this>/<key>
# (same value as NEXT_PUBLIC_AWS_IMAGES_CDN_BASE_URL in Client/.env)
AWS_IMAGES_CDN_BASE_URL=https://d1vstek0gf8y4r.cloudfront.net
